# Registry
REGISTRY=ghcr.io/<github-user-ou-organisation>
IMAGE_TAG=1.0.0
IMAGE_PULL_POLICY=IfNotPresent

# Kubernetes
NAMESPACE=m2cloud
RELEASE_NAME=dotnetgigs
INGRESS_HOST=dotnetgigs.local
INGRESS_CLASS=nginx
TLS_SECRET_NAME=dotnetgigs-tls

# Upstream source
UPSTREAM_REPO=https://github.com/bart120/m2cloud.git
UPSTREAM_APP_PATH=appscore

# Local cluster
KIND_CLUSTER_NAME=m2cloud
KIND_CONFIG=clusters/kind/kind-config.yaml

# Secrets de démo - à remplacer en vrai contexte
SQL_SA_PASSWORD=Pass@word12345!
RABBITMQ_DEFAULT_USER=m2cloud
RABBITMQ_DEFAULT_PASS=M2CloudRabbit123!
